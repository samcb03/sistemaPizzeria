<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uv.lis.gui.usuarios.UsuariosController"
      spacing="12" style="-fx-background-color: #F3F5F8; -fx-padding: 20;">


    <Label text="Gestión de Usuarios"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1B1E;"/>


    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;">
        <TextField fx:id="txtBuscar" promptText="Buscar..." prefWidth="280" prefHeight="36"
                   style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 12;"/>
        <ComboBox fx:id="cbBuscarPor" prefHeight="36"
                  style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB;"/>
        <Button text="🔍 Buscar" onAction="#onBuscar" prefHeight="36"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nuevo Cliente"  onAction="#onNuevoCliente" prefHeight="36"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="+ Nuevo Empleado" onAction="#onNuevoEmpleado" prefHeight="36"
                style="-fx-background-color: #1A1B1E; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <Tab text="👥 Clientes">
            <VBox spacing="8" style="-fx-padding: 10;">
                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS" prefHeight="480"
                           style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colCIdUsuario" text="ID"      prefWidth="60"/>
                        <TableColumn fx:id="colCNombre"    text="Nombre"  prefWidth="300"/>
                        <TableColumn fx:id="colCCiudad"    text="Ciudad"  prefWidth="160"/>
                        <TableColumn fx:id="colCEstatus"   text="Estatus" prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No hay clientes registrados."/></placeholder>
                </TableView>
                <HBox spacing="8">
                    <Button text="✏ Editar"   onAction="#onEditarCliente"
                            style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="🗑 Eliminar" onAction="#onEliminarCliente"
                            style="-fx-background-color: #FEEDED; -fx-text-fill: #C82429; -fx-border-color: #C82429; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="🔑 Empleados">
            <VBox spacing="8" style="-fx-padding: 10;">
                <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS" prefHeight="480"
                           style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colEIdUsuario" text="ID"       prefWidth="60"/>
                        <TableColumn fx:id="colENombre"    text="Nombre"   prefWidth="260"/>
                        <TableColumn fx:id="colEUsername"  text="Usuario"  prefWidth="160"/>
                        <TableColumn fx:id="colERol"       text="Rol"      prefWidth="130"/>
                        <TableColumn fx:id="colEEstatus"   text="Estatus"  prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No hay empleados registrados."/></placeholder>
                </TableView>
                <HBox spacing="8">
                    <Button text="✏ Editar"   onAction="#onEditarEmpleado"
                            style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button text="🗑 Eliminar" onAction="#onEliminarEmpleado"
                            style="-fx-background-color: #FEEDED; -fx-text-fill: #C82429; -fx-border-color: #C82429; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
