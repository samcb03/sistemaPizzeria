<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="800" prefWidth="1280" style="-fx-background-color: #F3F5F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.gui.main.MenuPrincipalController">

    <!-- MENU BAR -->
    <top>
        <VBox>
            <MenuBar style="-fx-background-color: #C82429; -fx-padding: 2 0;">
                <!-- Logo -->
                <Menu style="-fx-text-fill: black -fx-font-weight: bold; -fx-font-size: 14px;" text="🍕 Italia Pizza" />

                <Menu style="-fx-text-fill: white;" text="Administración">
                    <MenuItem fx:id="miUsuarios" onAction="#onUsuarios" text="👥  Usuarios" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="miCerrarSesion" onAction="#onCerrarSesion" text="🔒  Cerrar Sesión" />
                </Menu>

                <Menu style="-fx-text-fill: white;" text="Inventarios">
                    <MenuItem onAction="#onProductos" text="🍕  Productos" />
                    <MenuItem onAction="#onInventario" text="📦  Reporte de Inventario" />
                    <MenuItem onAction="#onValidarInv" text="✔   Validar Inventario" />
                </Menu>

                <Menu style="-fx-text-fill: white;" text="Pedidos">
                    <MenuItem onAction="#onPedidos" text="📋  Pedidos" />
                </Menu>

                <Menu style="-fx-text-fill: white;" text="Ayuda">
                    <MenuItem onAction="#onAcercaDe" text="ℹ   Acerca de" />
                </Menu>

                <!-- Spacer + usuario -->
                <Menu disable="true" style="-fx-padding: 0 0 0 600;" text="" />
                <Menu disable="true">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 12;">
                            <Label fx:id="lblUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" text="Empleado" />
                            <Label style="-fx-text-fill: #555;" text="|" />
                            <Label fx:id="lblRol" style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;" text="Rol" />
                        </HBox>
                    </graphic>
                </Menu>
            </MenuBar>
        </VBox>
    </top>

    <!-- CONTENT se carga dinámicamente -->
    <center>
        <StackPane style="-fx-background-color: #F3F5F8; -fx-padding: 16;">
            <Label style="-fx-font-size: 15px; -fx-text-fill: #999FAB;" text="Selecciona una opción del menú para comenzar." />
        </StackPane>
    </center>
</BorderPane>
