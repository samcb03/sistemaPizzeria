<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uv.lis.gui.inventario.ValidarInventarioController"
      spacing="12" style="-fx-background-color: #F3F5F8; -fx-padding: 20;">

    <Label text="Validación de Inventario"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1B1E;"/>
    <Label text="Captura la cantidad física de cada producto para compararla con el sistema."
           style="-fx-text-fill: #4F5561; -fx-font-size: 13px;"/>

    <TableView fx:id="tblValidar" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto"       prefWidth="240"/>
            <TableColumn fx:id="colSistema"  text="Cant. Sistema"  prefWidth="140"/>
        </columns>
        <placeholder><Label text="Cargando productos..."/></placeholder>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="✔ Registrar Conteo" onAction="#onRegistrar" prefHeight="40"
                style="-fx-background-color: #16A66E; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
