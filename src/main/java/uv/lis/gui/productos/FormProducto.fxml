<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uv.lis.gui.productos.FormProductoController"
      spacing="14" prefWidth="420"
      style="-fx-background-color: white; -fx-padding: 28;">

    <Label fx:id="lblTitulo" text="Nuevo Producto"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1B1E;"/>
    <Separator/>

    <GridPane hgap="12" vgap="10">
        <Label text="Nombre *"         GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre"   GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220"/>
        <Label text="Descripción *"    GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDescripcion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Restricciones"    GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtRestricciones" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Precio *"         GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecio"   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Cantidad"         GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCantidad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="¿Es preparado?"   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkPreparado" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblError" style="-fx-text-fill: #C82429;" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8;"/>
        <Button text="Guardar" onAction="#onGuardar"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
