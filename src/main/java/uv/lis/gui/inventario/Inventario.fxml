<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uv.lis.gui.inventario.InventarioController"
      spacing="12" style="-fx-background-color: #F3F5F8; -fx-padding: 20;">

    <Label text="Reporte de Inventario"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1B1E;"/>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;">
        <Label text="Último conteo registrado" style="-fx-text-fill: #4F5561; -fx-font-size: 13px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄 Exportar CSV" onAction="#onExportarCSV" prefHeight="36"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tblInventario" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colProducto"   text="Producto"        prefWidth="220"/>
            <TableColumn fx:id="colSistema"    text="Cant. Sistema"   prefWidth="130"/>
            <TableColumn fx:id="colReal"       text="Cant. Real"      prefWidth="130"/>
            <TableColumn fx:id="colDiferencia" text="Diferencia"      prefWidth="110"/>
            <TableColumn fx:id="colResultado"  text="Resultado"       prefWidth="120"/>
        </columns>
        <placeholder><Label text="No hay conteos registrados."/></placeholder>
    </TableView>
</VBox>
