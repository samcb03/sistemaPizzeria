<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="uv.lis.gui.productos.ProductosController"
      spacing="12" style="-fx-background-color: #F3F5F8; -fx-padding: 20;">

    <Label text="Gestión de Productos"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1B1E;"/>

    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre..." prefWidth="300" prefHeight="36"
                   style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-border-radius: 8; -fx-background-radius: 8;"/>
        <Button text="🔍 Buscar" onAction="#onBuscar" prefHeight="36"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="🔄 Actualizar" onAction="#onActualizar" prefHeight="36"
                style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄 Exportar CSV" onAction="#onExportarCSV" prefHeight="36"
                style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="+ Nuevo Producto" onAction="#onNuevo" prefHeight="36"
                style="-fx-background-color: #C82429; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colId"          text="ID"          prefWidth="60"/>
            <TableColumn fx:id="colNombre"       text="Nombre"      prefWidth="200"/>
            <TableColumn fx:id="colDescripcion"  text="Descripción" prefWidth="280"/>
            <TableColumn fx:id="colPrecio"       text="Precio"      prefWidth="90"/>
            <TableColumn fx:id="colCantidad"     text="Cantidad"    prefWidth="90"/>
            <TableColumn fx:id="colDisponible"   text="Estado"      prefWidth="100"/>
        </columns>
        <placeholder><Label text="No hay productos registrados."/></placeholder>
    </TableView>

    <HBox spacing="8">
        <Button text="✏ Editar"   onAction="#onEditar"
                style="-fx-background-color: #F3F5F8; -fx-border-color: #E2E5EB; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button text="🗑 Eliminar" onAction="#onEliminar"
                style="-fx-background-color: #FEEDED; -fx-text-fill: #C82429; -fx-border-color: #C82429; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
